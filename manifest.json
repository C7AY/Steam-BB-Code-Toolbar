{
  "manifest_version": 3,
  "name": "Steam BB Code Toolbar",
  "version": "1.0",
  "description": "Добавляет Панель BB-кодов на страницы Steam в поля ввода.",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/*",
        "https://store.steampowered.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
